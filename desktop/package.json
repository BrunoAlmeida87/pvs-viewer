{
  "name": "pvs-viewer-desktop",
  "productName": "Visualizador PVS",
  "version": "1.0.0",
  "description": "Visualizador de modelos Creo View (.pvs + .ol) para Windows",
  "main": "main.js",
  "author": "Bruno",
  "private": true,
  "scripts": {
    "copy": "node scripts/copy-viewer.js",
    "start": "npm run copy && electron .",
    "dist": "npm run copy && electron-builder --win portable",
    "dist:dir": "npm run copy && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.bruno.pvsviewer",
    "productName": "Visualizador PVS",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "VisualizadorPVS-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
